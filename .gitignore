# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local environment. Values belong on the machine, not in a public repo —
# see .env.example for the names.
.env
.env.*
!.env.example

# Incremental state written by `tsc --build`
*.tsbuildinfo

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local tooling state
.claude/

# Design handoff bundles (raw export, not source)
design-handoff/

# Supabase CLI scratch state — which project this checkout is linked to,
# and the CLI version it last used. Local to a machine, not to the project.
supabase/.temp/

# Wrangler's local build and state cache
.wrangler/

# Local Supabase stack state, written by `supabase start`
supabase/.branches/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Originals saved by scripts/backfill-image-thumbnails.ts before it overwrites
# them. Other people's photos — they belong on the machine, not in the repo.
/backup/
