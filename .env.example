# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it
# carries names only — never paste a real value here.

# The world map on /results. Without it the map renders its error state and
# everything else on the site works as normal.
#
# Must be a *public* token (starts with `pk.`). Restrict it to your domains in
# the Mapbox dashboard under the token's URL restrictions before using it —
# Mapbox bills per map load, and a bundled token is readable by anyone who
# opens the site.
VITE_MAPBOX_PUBLIC_KEY=

# Note: Supabase needs nothing here. `src/integrations/supabase/client.ts` is
# generated with the project URL and the anon key written into it, so there is
# no VITE_SUPABASE_* variable to set — earlier copies of `.env` carried some,
# but nothing has ever read them.
