# Security headers, served by the assets Worker.
#
# These used to be a <meta> tag that src/lib/securityHeaders.ts appended after
# the bundle booted. That policy could only govern what happened from then on:
# everything index.html did during the initial parse — the font stylesheet, the
# Lovable tag, the inline scripts — was already fetched and run before any
# policy existed. A CSP that arrives after first paint is documentation, not
# enforcement.
#
# As real headers they also unlock three things a meta tag cannot express at
# all: frame-ancestors, X-Content-Type-Options (browsers ignore the meta form),
# and Permissions-Policy.
#
# Cloudflare's assets runtime reads this file from the root of ./dist; Vite
# copies public/ there verbatim.

/*
  # Same-origin by default; every exception below is deliberate.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.gpteng.co https://api.mapbox.com https://counterscale.peterreijm.workers.dev; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.mapbox.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://jtabjndnietpewvknjrm.supabase.co wss://jtabjndnietpewvknjrm.supabase.co https://api.mapbox.com https://*.tiles.mapbox.com https://events.mapbox.com https://world.openfoodfacts.org https://counterscale.peterreijm.workers.dev https://*.ingest.sentry.io https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

  # Belt and braces with frame-ancestors, for anything that predates it.
  X-Frame-Options: DENY

  # Only meaningful as a header. The <meta http-equiv> form was ignored.
  X-Content-Type-Options: nosniff

  Referrer-Policy: strict-origin-when-cross-origin

  # The rating flow photographs cartons, so the camera stays available to us.
  # Nothing here needs a microphone, a location, or a payment handler.
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
